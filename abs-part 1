import java.util.ArrayList;
import java.util.Scanner;
import java.io.*;

// Represents a single logged exercise/workout entry
class Workout {
    String exerciseName;
    int sets;
    int reps;
    int durationMinutes;
    double caloriesBurned;

Workout(String exerciseName, int sets, int reps, int durationMinutes, double caloriesBurned) {
        this.exerciseName = exerciseName;
        this.sets = sets;
        this.reps = reps;
        this.durationMinutes = durationMinutes;
        this.caloriesBurned = caloriesBurned;
    }

    // Convert workout details into a line for file storage
    String toFileLine() {
        return exerciseName + "," + sets + "," + reps + "," + durationMinutes + "," + caloriesBurned;
    }

static Workout fromFileLine(String line) {
        String[] parts = line.split(",");
        return new Workout(parts[0], Integer.parseInt(parts[1]), Integer.parseInt(parts[2]),
                Integer.parseInt(parts[3]), Double.parseDouble(parts[4]));
    }
@Override
    public String toString() {
        return String.format("%-15s Sets: %-3d Reps: %-3d Duration: %-3d min  Calories: %.2f",
                exerciseName, sets, reps, durationMinutes, caloriesBurned);
    }
}

